# Local debug: SPA + proxy in one process (not used by gcloud --source).
FROM node:22-trixie AS server
WORKDIR /pre
COPY /chapterdesk-api-server/package.json /chapterdesk-api-server/package-lock.json ./
RUN npm ci
COPY /chapterdesk-api-server/tsconfig.json ./
COPY /chapterdesk-api-server/src ./src
RUN npx tsc

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY angular.json tsconfig.json tsconfig.app.json ./
COPY public ./public
COPY src ./src
RUN npx ng build --configuration=development --base-href=/ --output-path=/out
WORKDIR /pre


FROM node:22-trixie
WORKDIR /app
COPY --from=server /pre/node_modules ./node_modules
COPY --from=server /pre/dist ./dist
COPY --from=server /pre/package.json /pre/package-lock.json /pre/tsconfig.json ./dist
COPY --from=server /pre/src ./src
COPY --from=server /out/browser ./public
ENV NODE_ENV=development
ENV PORT=8080

EXPOSE 8080 9229
CMD ["node", "dist/server.js"]

