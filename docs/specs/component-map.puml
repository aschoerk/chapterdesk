}

package "Test doubles (test-helpers/)" as DOUBLES {
  component "factories.ts\nin-memory-chat-api.ts\nfake-prompt-api.ts" as HELPERS
}

cloud "External" as EXT {
  [LLM / image providers\n(OpenAI-compatible + OpenRouter)] as PROVIDER
  [IndexedDB] as IDB_EXT
  [SQLite file] as SQLITE
}

