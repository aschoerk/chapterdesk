<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo for Chapterly.

  This file is the standard machine-readable description that distro catalogs,
  app centers (GNOME Software / KDE Discover / Flathub) and package checkers
  (appstreamcli) consume.

  How it is used per channel:
    - Flathub: hosts its own copy in the flathub/io.github.aschoerk.chapterly
      repository; this file is the canonical source for it.
    - Debian/Ubuntu (.deb via electron-builder): no native hook exists in
      electron-builder to drop a file into /usr/share/metainfo, so on the
      distro side it is added from this file (OBS/PPA wrapper, or a Debian
      package without the embedded runtime).
    - AppImage / OBS / AUR: validate with `appstreamcli validate <this file>`.

  If you change the app-id here, keep it in sync with:
    - packaging/chapterly.desktop  (StartupWMClass / desktop-id)
    - the Flatpak manifest         (>app-id>)
    - the Windows/MSIX identity    (package.json -> build.msix.identityName)
-->
<component type="desktop-application">
  <id>io.github.aschoerk.chapterly</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>Chapterly</name>
  <summary>Offline-first AI-assisted story writing client</summary>

  <description>
    <p>
      Chapterly is an offline-first writing application for longer fiction.
      It runs its own local API server (SQLite storage in your user data
      directory), keeps every chapter and revision versioned, and lets you
      call the LLM provider of your choice to narrate, continue, branch,
      rewrite or illustrate your story.
    </p>
    <p>
      Your data lives on your machine; nothing is uploaded except the text you
      explicitly send to a language model you configured.
    </p>
  </description>

  <launchable type="desktop-id">chapterly.desktop</launchable>

  <developer_name>Andreas Schörk</developer_name>

  <url type="homepage">https://github.com/aschoerk/chapterly</url>
  <url type="bugtracker">https://github.com/aschoerk/chapterly/issues</url>
  <url type="vcs-browser">https://github.com/aschoerk/chapterly</url>

  <provides>
    <binary>chapterly</binary>
  </provides>

  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>

  <screenshots>
    <!-- TODO: add real screenshots before submitting anywhere strict
    <screenshot type="default">
      <image type="source" width="1280" height="860">https://raw.githubusercontent.com/aschoerk/chapterly/main/docs/screenshot.png</image>
    </screenshot>
    -->
  </screenshots>

  <releases>
    <release version="0.12.11" date="2026-10-12"/>
  </releases>

  <content_rating type="oars-1.1"/>
</component>