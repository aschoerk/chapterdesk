<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo for ChapterDesk.

  This file is the standard machine-readable description that distro catalogs,
  app centers (GNOME Software / KDE Discover / Flathub) and package checkers
  (appstreamcli) consume.

  How it is used per channel:
    - Flathub: hosts its own copy in the flathub/io.github.aschoerk.chapterdesk
      repository; this file is the canonical source for it.
    - Debian/Ubuntu (.deb via electron-builder): no native hook exists in
      electron-builder to drop a file into /usr/share/metainfo, so on the
      distro side it is added from this file (OBS/PPA wrapper, or a Debian
      package without the embedded runtime).
    - AppImage / OBS / AUR: validate with `appstreamcli validate <this file>`.

  If you change the app-id here, keep it in sync with:
    - packaging/ChapterDesk.desktop  (StartupWMClass / desktop-id)
    - the Flatpak manifest         (&gt;app-id&gt;)
    - the Windows/MSIX identity    (package.json -> build.msix.identityName)
-->
<component type="desktop-application">
  <id>io.github.aschoerk.chapterdesk</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>ChapterDesk</name>
  <summary>Offline-first AI-assisted story writing client</summary>

  <description>
    <p>
      ChapterDesk is an offline-first writing application for longer fiction.
      It runs its own local API server (SQLite storage in your user data
      directory), keeps every chapter and revision versioned, and lets you
      call the LLM provider of your choice to narrate, continue, branch,
      rewrite or illustrate your story.
    </p>
    <p>
      Your data lives on your machine; nothing is uploaded except the text you
      explicitly send to a language model you configured.
    </p>
  </description>

  <launchable type="desktop-id">ChapterDesk.desktop</launchable>

  <developer id="https://github.com/aschoerk">
    <name>Andreas Schörk</name>
  </developer>

  <url type="homepage">https://github.com/aschoerk/chapterdesk</url>
  <url type="bugtracker">https://github.com/aschoerk/chapterdesk/issues</url>
  <url type="vcs-browser">https://github.com/aschoerk/chapterdesk</url>

  <provides>
    <binary>ChapterDesk</binary>
  </provides>

  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>

  <screenshots>
    <screenshot type="default">
      <image type="source" width="1600" height="1000">https://raw.githubusercontent.com/aschoerk/chapterdesk/main/assets/screenshots/steering-view.png</image>
      <caption>The steering view — a direction on the left, the chapter streams in below.</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="1600" height="1000">https://raw.githubusercontent.com/aschoerk/chapterdesk/main/assets/screenshots/book-view.png</image>
      <caption>The book view — read the active path as continuous prose.</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="1600" height="1000">https://raw.githubusercontent.com/aschoerk/chapterdesk/main/assets/screenshots/illustrate.png</image>
      <caption>Illustrate a scene and keep the picture with the chapter.</caption>
    </screenshot>
  </screenshots>

  <releases>
